{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "shared-frontend": ["../shared-frontend/src/index.ts"],
      "shared-frontend/style.css": ["../shared-frontend/dist/index.min.css"],
      "shared-frontend/*": ["../shared-frontend/src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}